FROM node:14.21.2-alpine

ARG BASE_URL
ARG API_BASE_URL
ARG IMAGE_URL
ARG LANG_RU
ARG LANG_EN
ARG LANG_CN


ENV BASE_URL=$BASE_URL
ENV API_BASE_URL=$API_BASE_URL
ENV IMAGE_URL=$IMAGE_URL
ENV LANG_RU=$LANG_RU
ENV LANG_EN=$LANG_EN
ENV LANG_CN=$LANG_CN

WORKDIR /app

ADD . /app
RUN env
RUN npm install
RUN npm run build

CMD ["npm", "run", "start"]
